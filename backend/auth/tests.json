{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET check — нет сессии",
      "method": "GET",
      "path": "/?action=check",
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "forgot_password — нет пользователя",
      "method": "POST",
      "path": "/",
      "body": {"action": "forgot_password", "username": "nonexistent_xyz", "email": "no@no.com"},
      "expectedStatus": 404,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "manual_list — нет сессии",
      "method": "GET",
      "path": "/?action=manual_list&broker=sberbank",
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    },
    {
      "name": "manual_add — нет сессии",
      "method": "POST",
      "path": "/",
      "body": {"action": "manual_add", "broker": "sberbank", "ticker": "SBER", "lots": 1, "buy_price": 250},
      "expectedStatus": 401,
      "expectedBody": {"ok": false},
      "bodyMatcher": "partial"
    }
  ]
}